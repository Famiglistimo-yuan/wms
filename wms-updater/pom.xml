<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.wms</groupId>
    <artifactId>wms-parent</artifactId>
    <version>1.0.1</version>
  </parent>

  <artifactId>wms-updater</artifactId>
  <name>wms-updater</name>
  <description>FR-6 自动升级执行器：等待主程序退出后下载/校验/替换主 jar 并重启（纯 JDK + Swing，零业务依赖）</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>updater</finalName>
    <plugins>
      <plugin>
        <!-- fat jar：Updater 无第三方依赖，shade 主要消费 manifest 主类与最终命名固定（updater.jar）。
             execution id 避开 SB parent pluginManagement 的 default，防配置合并解析冲突 -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>shade-updater</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.wms.updater.Updater</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
