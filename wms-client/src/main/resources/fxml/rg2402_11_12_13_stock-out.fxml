<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wms.wmsclient.controller.StockIoController">

    <top>
        <HBox spacing="8" style="-fx-padding: 8px;">
            <Label fx:id="lblTitle" text="出仓录入" styleClass="title"/>
            <Label text="  ｜" styleClass="subtle"/>
            <Label text="物料："/>
            <TextField fx:id="tfSearch" promptText="代码 / 名称 / 规格" onAction="#onRefreshClicked" prefWidth="200"/>
            <Button text="查询/刷新" onAction="#onRefreshClicked"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tvMaterials" editable="true"/>
    </center>

    <bottom>
        <VBox spacing="4" style="-fx-padding: 4px 8px;">
            <HBox spacing="8">
                <Label text="经手人："/>
                <ComboBox fx:id="cbHandler" prefWidth="180"/>
                <Label text="整单备注："/>
                <TextField fx:id="tfRemark" promptText="（可选）本批出仓备注" prefWidth="260"/>
                <Button fx:id="btnSubmit" text="确认出仓" onAction="#onSubmitClicked"/>
            </HBox>
            <HBox spacing="8">
                <Label fx:id="lblStatus" text="正在加载物料列表…" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnPrev" text="◀ 上一页" onAction="#onPrevPage"/>
                <Label fx:id="lblPage" text="1 / 1"/>
                <Button fx:id="btnNext" text="下一页 ▶" onAction="#onNextPage"/>
                <Label text="每页"/>
                <TextField fx:id="tfPageSize" promptText="20" prefWidth="50" onAction="#onApplyPageSize"/>
                <Label text="条"/>
                <Label text="跳到"/>
                <TextField fx:id="tfJumpPage" promptText="页码" prefWidth="50" onAction="#onJumpPage"/>
                <Label text="页"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
