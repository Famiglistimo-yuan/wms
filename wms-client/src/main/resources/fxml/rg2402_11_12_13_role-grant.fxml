<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.wms.wmsclient.controller.RoleGrantController"
      stylesheets="@../styles.css"
      spacing="8">
  <ToolBar>
    <Button text="刷新" onAction="#onRefreshClicked"/>
  </ToolBar>
  <Label text="角色列表（左） / 权限勾选（右）" styleClass="subtle"/>
  <HBox spacing="8" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
    <ListView prefWidth="200" HBox.hgrow="NEVER" fx:id="lvRoles"/>
    <ListView HBox.hgrow="ALWAYS" fx:id="lvPermissions"/>
  </HBox>
  <Label fx:id="lblStatus" styleClass="subtle"/>
</VBox>
