<?xml version="1.0" encoding="UTF-8"?>

<?import com.wms.wmsclient.ui.FxmlFusionButton?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.wms.wmsclient.controller.UserManageController"
      spacing="8">
  <ToolBar>
    <FxmlFusionButton text="刷新" onAction="#onRefreshClicked" prefWidth="88" prefHeight="32"/>
    <TextField fx:id="tfSearch" promptText="用户名 / 人员编号 / 姓名" onAction="#onSearchClicked" prefWidth="200"/>
    <FxmlFusionButton text="搜索" onAction="#onSearchClicked" prefWidth="88" prefHeight="32"/>
    <FxmlFusionButton text="新增用户" onAction="#onCreateUserClicked" prefWidth="88" prefHeight="32"/>
    <FxmlFusionButton text="启/停用" onAction="#onToggleStatusClicked" prefWidth="88" prefHeight="32"/>
    <FxmlFusionButton text="修改密码" onAction="#onChangePasswordClicked" prefWidth="88" prefHeight="32"/>
    <FxmlFusionButton text="删除用户" onAction="#onDeleteUserClicked" prefWidth="88" prefHeight="32"/>
  </ToolBar>
  <TableView fx:id="tvUsers" VBox.vgrow="ALWAYS" editable="false"/>
  <Separator/>
  <Label fx:id="lblStatus" styleClass="subtle"/>
</VBox>
