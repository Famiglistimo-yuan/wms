<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<BorderPane stylesheets="@../styles.css" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.wms.wmsclient.controller.MainController">
  <top>
    <!-- 「更多」放菜单栏右侧独立按钮：MenuBar 点击 Menu 只展开下拉（空 Menu 连 showing 都不触发），
         弹面板动作必须走 Button onAction，与登录窗同一路径 -->
    <HBox>
      <MenuBar>
      <Menu fx:id="menuPerson" text="人员档案">
        <MenuItem fx:id="miPersonView" text="查询" onAction="#onPersonViewClicked"/>
        <MenuItem fx:id="miPersonAdd" text="增加" onAction="#onPersonAddClicked"/>
        <MenuItem fx:id="miPersonEdit" text="修改" onAction="#onPersonEditClicked"/>
        <MenuItem fx:id="miPersonDelete" text="删除" onAction="#onPersonDeleteClicked"/>
      </Menu>
      <Menu fx:id="menuMaterial" text="物料档案">
        <MenuItem fx:id="miMaterialView" text="查询" onAction="#onMaterialViewClicked"/>
        <MenuItem fx:id="miMaterialAdd" text="增加" onAction="#onMaterialAddClicked"/>
        <MenuItem fx:id="miMaterialEdit" text="修改" onAction="#onMaterialEditClicked"/>
        <MenuItem fx:id="miMaterialDelete" text="删除" onAction="#onMaterialDeleteClicked"/>
      </Menu>
      <Menu fx:id="menuStock" text="进出仓">
        <MenuItem fx:id="miStockIn" text="进仓录入" onAction="#onStockInClicked"/>
        <MenuItem fx:id="miStockOut" text="出仓录入" onAction="#onStockOutClicked"/>
        <MenuItem fx:id="miStockQuery" text="单据查询" onAction="#onStockQueryClicked"/>
      </Menu>
      <Menu fx:id="menuStats" text="统计报表">
        <MenuItem fx:id="miStatsFlow" text="物料流量统计" onAction="#onStatsFlowClicked"/>
        <MenuItem fx:id="miStatsMonthly" text="月度进出仓单" onAction="#onStatsMonthlyClicked"/>
        <MenuItem fx:id="miStatsLedger" text="仓库账本" onAction="#onStatsLedgerClicked"/>
      </Menu>
      <Menu fx:id="menuAuth" text="系统管理">
        <MenuItem fx:id="miAuthUser" text="用户管理" onAction="#onAuthUserClicked"/>
        <MenuItem fx:id="miAuthGrant" text="权限授予" onAction="#onAuthGrantClicked"/>
        <MenuItem text="退出登录" onAction="#onLogoutClicked"/>
      </Menu>
      </MenuBar>
      <Region HBox.hgrow="ALWAYS"/>
      <Button text="更多" onAction="#onMoreClicked" styleClass="primary-btn"/>
    </HBox>
  </top>
  <center>
    <Label fx:id="lblUser" styleClass="subtle"/>
  </center>
</BorderPane>
