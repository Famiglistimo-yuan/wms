<?xml version="1.0" encoding="UTF-8"?>

<?import com.wms.wmsclient.ui.FxmlFusionButton?>
<?import io.vproxy.vfx.ui.wrapper.ThemeLabel?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wms.wmsclient.controller.PersonManageController">

    <top>
        <HBox spacing="8" style="-fx-padding: 8px;">
            <ThemeLabel text="姓名单字："/>
            <TextField fx:id="tfSearch" promptText="输入任意一个字，如「王」" onAction="#onRefreshClicked"
                       prefWidth="180"/>
            <FxmlFusionButton fx:id="btnRefresh" text="查询/刷新" onAction="#onRefreshClicked"
                          prefWidth="80" prefHeight="26"/>
            <FxmlFusionButton text="新增" onAction="#onCreateClicked" prefWidth="80" prefHeight="26"/>
            <FxmlFusionButton text="修改" onAction="#onEditClicked" prefWidth="80" prefHeight="26"/>
            <FxmlFusionButton text="删除" onAction="#onDeleteClicked" prefWidth="80" prefHeight="26"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tvPersons" editable="false"/>
    </center>

    <bottom>
        <HBox style="-fx-padding: 4px 8px;">
            <ThemeLabel fx:id="lblStatus" text="点击查询加载人员列表" HBox.hgrow="ALWAYS"/>
        </HBox>
    </bottom>
</BorderPane>
