<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="16.0" stylesheets="@../styles.css"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.wms.wmsclient.controller.LoginController">
  <padding>
    <Insets bottom="24.0" left="32.0" right="32.0" top="24.0"/>
  </padding>

  <Label text="仓库管理系统" styleClass="title"/>

  <!-- HBox 包裹 + hgrow=NEVER：GridPane 不随窗口拉伸，任意窗口尺寸下表单整体水平居中 -->
  <HBox alignment="CENTER">
    <GridPane hgap="10.0" vgap="12.0" HBox.hgrow="NEVER">
      <Label text="用户名：" GridPane.rowIndex="0"/>
      <TextField fx:id="tfUsername" GridPane.columnIndex="1" GridPane.rowIndex="0"
                 promptText="字母开头，4-30 位"/>
      <Label text="口令：" GridPane.rowIndex="1"/>
      <PasswordField fx:id="pfPassword" GridPane.columnIndex="1" GridPane.rowIndex="1"
                     promptText="6-20 位字母/数字"/>
    </GridPane>
  </HBox>

  <HBox alignment="CENTER" spacing="12.0">
    <Button fx:id="btnLogin" text="登录" onAction="#onLoginClicked" styleClass="primary-btn"
            defaultButton="true"/>
  </HBox>
</VBox>
